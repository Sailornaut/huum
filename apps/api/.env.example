# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=huum
DATABASE_PASSWORD=huum_secret
DATABASE_NAME=huum

# JWT
JWT_SECRET=change-me-to-a-real-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# S3-compatible media storage
S3_REGION=us-east-1
S3_BUCKET=huum-media
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# App
PORT=3000
NODE_ENV=development
# Comma-separated allowlist; Vercel preview URLs are also allowed automatically.
CORS_ORIGINS=http://localhost:5173
